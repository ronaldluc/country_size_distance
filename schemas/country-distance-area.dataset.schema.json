{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/country-distance-area.dataset.schema.json",
  "title": "Country Distance/Area Dataset",
  "description": "Schema for precomputed country rows used by the frontend scatter chart.",
  "type": "object",
  "required": [
    "generated_at",
    "generator_version",
    "brno_reference",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of dataset generation."
    },
    "generator_version": {
      "type": "string",
      "description": "Semver of the data build script."
    },
    "brno_reference": {
      "type": "object",
      "required": [
        "name",
        "lat",
        "lon"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "const": "Brno, Czechia"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "iso3",
          "name",
          "continent",
          "population",
          "area_km2",
          "distance_km_from_brno",
          "point_source",
          "point_lat",
          "point_lon"
        ],
        "additionalProperties": false,
        "properties": {
          "iso3": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 3166-1 alpha-3 country code."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "continent": {
            "type": "string",
            "enum": [
              "Africa",
              "Antarctica",
              "Asia",
              "Europe",
              "North America",
              "Oceania",
              "Seven seas (open ocean)",
              "South America"
            ]
          },
          "population": {
            "type": "number",
            "minimum": 0
          },
          "area_km2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "distance_km_from_brno": {
            "type": "number",
            "minimum": 0
          },
          "point_source": {
            "type": "string",
            "enum": [
              "centroid",
              "capital_fallback"
            ]
          },
          "point_lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "point_lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "capital_name": {
            "type": "string"
          },
          "outlier_flags": {
            "type": "object",
            "description": "Optional precomputed outlier tags from the build step.",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
